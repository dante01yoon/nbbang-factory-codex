{
  "version": 1,
  "lang": "ko",
  "mode": "enforce",
  "on_error": "block",
  "protect": {
    "paths": [
      "tests/",
      "test/",
      "__tests__/",
      "/e2e/",
      "**/*.test.*",
      "**/*.spec.*",
      "vitest.config.*",
      "vitest.workspace.*",
      "jest.config.*",
      "playwright.config.*",
      ".codex/hooks.json",
      ".codex/config.toml",
      ".codex/harness/",
      ".codex/agents/",
      ".agents/skills/",
      "scripts/factory",
      "!test/regression/"
    ],
    "allow_commands": [
      "npm test",
      "npm run test",
      "pnpm test",
      "pnpm run test",
      "yarn test",
      "bun test",
      "npx vitest run",
      "npx vitest",
      "npx jest",
      "npx playwright test",
      "npx tsc --noEmit",
      "python3 .codex/harness/harness.py"
    ]
  },
  "deny_read": {
    "paths": [
      ".env",
      ".env.*",
      "!.env.example",
      "!.env.sample",
      "!.env.template",
      "*.pem",
      "id_rsa",
      "id_ed25519"
    ]
  },
  "secrets": {
    "patterns": [
      {
        "id": "toss-live-key",
        "regex": "live_(?:sk|gsk|ck|gck)_[A-Za-z0-9]"
      },
      {
        "id": "stripe-live-key",
        "regex": "\\b(?:sk|rk)_live_[0-9A-Za-z]{10,}"
      },
      {
        "id": "openai-api-key",
        "regex": "\\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}"
      },
      {
        "id": "anthropic-api-key",
        "regex": "\\bsk-ant-(?:api|admin)\\d{2}-[A-Za-z0-9_-]{20,}"
      },
      {
        "id": "aws-access-key-id",
        "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
      },
      {
        "id": "github-token",
        "regex": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,})"
      },
      {
        "id": "slack-token",
        "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}"
      },
      {
        "id": "google-api-key",
        "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b"
      },
      {
        "id": "private-key",
        "regex": "-----BEGIN (?:[A-Z0-9]+ )?PRIVATE KEY-----"
      }
    ]
  },
  "verify": {
    "commands": [
      {
        "name": "test",
        "run": "npm test --silent",
        "timeout": 300
      }
    ],
    "skip_when_unchanged": true,
    "max_continuations_per_turn": 2,
    "output_tail_lines": 40
  },
  "log": {
    "enabled": true,
    "path": ".codex/harness/logs/events.jsonl",
    "max_bytes": 1000000
  },
  "examples": {
    "block": [
      {
        "why": "edit a test with apply_patch",
        "patch": "*** Begin Patch\n*** Update File: tests/rules/refund.test.ts\n@@\n-expect(refund).toBe(1500)\n+expect(refund).toBe(1000)\n*** End Patch"
      },
      {
        "why": "edit a colocated test",
        "patch": "*** Begin Patch\n*** Update File: src/cart.test.tsx\n@@\n-a\n+b\n*** End Patch"
      },
      {
        "why": "move a test away",
        "patch": "*** Begin Patch\n*** Update File: src/a.ts\n*** Move to: tests/a.ts\n*** End Patch"
      },
      {
        "why": "sed in place",
        "bash": "sed -i '' 's/1500/1000/' tests/rules/refund.test.ts"
      },
      {
        "why": "append with redirection",
        "bash": "echo 'it.skip()' >> tests/rules/refund.test.ts"
      },
      {
        "why": "delete the test folder",
        "bash": "rm -rf tests"
      },
      {
        "why": "cd then delete",
        "bash": "cd tests && rm rules/refund.test.ts"
      },
      {
        "why": "nested shell",
        "bash": "bash -lc \"rm tests/rules/refund.test.ts\""
      },
      {
        "why": "node one-liner write",
        "bash": "node -e \"require('fs').writeFileSync('tests/x.test.ts','')\""
      },
      {
        "why": "restore tests from git",
        "bash": "git checkout -- tests/rules/refund.test.ts"
      },
      {
        "why": "snapshot update",
        "bash": "npx vitest run -u"
      },
      {
        "why": "relax the test config",
        "patch": "*** Begin Patch\n*** Update File: vitest.config.ts\n@@\n-  include: ['tests/**/*.test.ts'],\n+  include: [],\n*** End Patch"
      },
      {
        "why": "format the whole project",
        "bash": "npx prettier --write ."
      },
      {
        "why": "heredoc into a test",
        "bash": "cat > tests/new.test.ts <<'EOF'\nit('passes', () => {})\nEOF"
      },
      {
        "why": "turn the harness off",
        "bash": "rm .codex/hooks.json"
      },
      {
        "why": "loosen the harness config",
        "patch": "*** Begin Patch\n*** Update File: .codex/harness/harness.json\n@@\n-  \"mode\": \"enforce\",\n+  \"mode\": \"observe\",\n*** End Patch"
      },
      {
        "why": "disable hooks in project config",
        "bash": "echo '[features]' >> .codex/config.toml"
      },
      {
        "why": "read .env",
        "bash": "cat .env"
      },
      {
        "why": "read .env through grep",
        "bash": "grep TOKEN .env.local"
      },
      {
        "why": "secret in a command",
        "bash": "export STRIPE=sk_live_abcdefghijklmnop1234"
      },
      {
        "why": "secret in a patch",
        "patch": "*** Begin Patch\n*** Add File: src/config.ts\n+export const KEY = \"live_sk_FAKE0000000000\";\n*** End Patch"
      },
      {
        "why": "private key in a patch",
        "patch": "*** Begin Patch\n*** Add File: deploy/key.txt\n+-----BEGIN OPENSSH PRIVATE KEY-----\n*** End Patch"
      }
    ],
    "allow": [
      {
        "why": "read a test",
        "bash": "cat tests/rules/refund.test.ts"
      },
      {
        "why": "search tests",
        "bash": "rg -n \"refund\" tests"
      },
      {
        "why": "run the tests",
        "bash": "npx vitest run tests/rules"
      },
      {
        "why": "type check",
        "bash": "npx tsc --noEmit"
      },
      {
        "why": "edit implementation",
        "patch": "*** Begin Patch\n*** Update File: src/rules/refund.ts\n@@\n-  return 0\n+  return 1500\n*** End Patch"
      },
      {
        "why": "format only src",
        "bash": "npx prettier --write src/rules/refund.ts"
      },
      {
        "why": "copy a test out to read",
        "bash": "cp tests/rules/refund.test.ts /tmp/refund.test.ts"
      },
      {
        "why": "diff tests",
        "bash": "git diff -- tests"
      },
      {
        "why": "inspect the harness",
        "bash": "cat .codex/harness/harness.json"
      },
      {
        "why": "run the harness doctor",
        "bash": "python3 .codex/harness/harness.py doctor"
      },
      {
        "why": "read the env example",
        "bash": "cat .env.example"
      },
      {
        "why": "test key is fine",
        "patch": "*** Begin Patch\n*** Add File: src/pay.ts\n+const key = process.env.TOSS_SECRET_KEY ?? \"test_sk_dummy\";\n*** End Patch"
      },
      {
        "why": "git status",
        "bash": "git status --short"
      },
      {
        "why": "list files",
        "bash": "ls -la"
      }
    ]
  }
}
